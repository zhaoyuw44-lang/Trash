<t id="381" p="270.00 309.00" BoundingBox="140.19 301.84 399.81 311.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="3" face="1">4-arm NCO-terminated prepolymer, PE-EO-(HDI)</s><s font="3" size="10" color="3" face="33">4</s></t>
<t id="382" p="270.00 320.00" BoundingBox="62.08 312.84 477.92 322.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="3" face="0">NCO functionality </s><s font="3" size="10" color="3" face="2">f</s><s font="3" size="10" color="3" face="0"> = 4</s><s font="3" size="10" color="3" face="0">;  </s><s font="3" size="10" color="3" face="2">a</s><s font="3" size="10" color="3" face="0">+</s><s font="3" size="10" color="3" face="2">b</s><s font="3" size="10" color="3" face="0">+</s><s font="3" size="10" color="3" face="2">c</s><s font="3" size="10" color="3" face="0">+</s><s font="3" size="10" color="3" face="2">d</s><s font="3" size="10" color="3" face="0"> ~ 15;  M</s><s font="3" size="10" color="3" face="32">n</s><s font="3" size="10" color="3" face="0"> ~1470;  11.4 wt% NCO (theor.)</s></t>
<t id="383" p="0.00 346.00" BoundingBox="0.00 338.84 212.94 348.00" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="1">(b) </s><s font="3" size="10" color="3" face="1">Glycerol ethoxylate (GE-EO, 3-arm)</s></t>
<t id="421" p="164.72 391.73" BoundingBox="164.72 384.57 170.28 393.73" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="2">n</s></t>
<t id="429" p="164.72 423.87" BoundingBox="164.72 416.71 170.28 425.87" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="2">n</s></t>
<t id="437" p="60.92 404.20" BoundingBox="60.92 397.04 66.48 406.20" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="2">n</s></t>
<t id="438" p="112.00 438.00" BoundingBox="59.46 430.84 164.54 440.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="3" face="0">glycerol ethoxylate</s></t>
<t id="439" p="112.00 449.00" BoundingBox="84.20 441.84 139.80 451.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="3" face="0">(M</s><s font="3" size="10" color="3" face="32">n</s><s font="3" size="10" color="3" face="0"> ~1000)</s></t>
<t id="440" p="112.00 460.00" BoundingBox="4.14 452.84 219.86 462.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="3" face="2">n</s><s font="3" size="10" color="3" face="0"> = 6-7 EO per arm (~20.6 EO in total)</s></t>
<t id="441" p="228.00 396.00" BoundingBox="224.11 385.98 231.89 398.00" Justification="Center" InterpretChemically="no"><s font="3" size="14" color="3" face="0">+</s></t>
<t id="466" p="356.00 416.00" BoundingBox="313.47 408.84 398.53 418.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="4" face="1">HDI, 100 equiv.</s></t>
<t id="467" p="356.00 427.00" BoundingBox="278.44 419.84 433.56 429.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="3" face="0">(hexamethylene diisocyanate)</s></t>
<t id="469" p="280.00 466.00" BoundingBox="280.00 458.84 461.22 468.00" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="0">NCO : OH = 200 : 3 (ca. 67 : 1)</s></t>
<t id="470" p="280.00 477.00" BoundingBox="280.00 469.84 512.38 479.00" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="0">each OH capped by one HDI (urethane bond)</s></t>
<t id="471" p="280.00 488.00" BoundingBox="280.00 480.84 464.02 490.00" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="0">excess HDI removed after reaction</s></t>
<t id="581" p="326.72 549.73" BoundingBox="326.72 542.57 332.28 551.73" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="2">n</s></t>
<t id="589" p="326.72 581.87" BoundingBox="326.72 574.71 332.28 583.87" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="2">n</s></t>
<t id="597" p="222.92 562.20" BoundingBox="222.92 555.04 228.48 564.20" Justification="Left" InterpretChemically="no"><s font="3" size="10" color="3" face="2">n</s></t>
<t id="598" p="270.00 615.00" BoundingBox="140.19 607.84 399.81 617.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="3" face="1">3-arm NCO-terminated prepolymer, GE-EO-(HDI)</s><s font="3" size="10" color="3" face="33">3</s></t>
<t id="599" p="270.00 626.00" BoundingBox="78.48 618.84 461.52 628.00" Justification="Center" InterpretChemically="no"><s font="3" size="10" color="3" face="0">NCO functionality </s><s font="3" size="10" color="3" face="2">f</s><s font="3" size="10" color="3" face="0"> = 3</s><s font="3" size="10" color="3" face="0">;  </s><s font="3" size="10" color="3" face="2">n</s><s font="3" size="10" color="3" face="0"> = 6-7;  M</s><s font="3" size="10" color="3" face="32">n</s><s font="3" size="10" color="3" face="0"> ~1505;  8.4 wt% NCO (theor.)</s></t>
<t id="600" p="0.00 650.00" BoundingBox="0.00 643.56 580.43 652.00" Justification="Left" InterpretChemically="no"><s font="3" size="9" color="3" face="2">a</s><s font="3" size="9" color="3" face="0">, </s><s font="3" size="9" color="3" face="2">b</s><s font="3" size="9" color="3" face="0">, </s><s font="3" size="9" color="3" face="2">c</s><s font="3" size="9" color="3" face="0">, </s><s font="3" size="9" color="3" face="2">d</s><s font="3" size="9" color="3" face="0">, </s><s font="3" size="9" color="3" face="2">n</s><s font="3" size="9" color="3" face="0"> = EO repeat units per arm (averages; supplier specs): PE-EO 15/4 EO/OH, </s><s font="3" size="9" color="3" face="2">a</s><s font="3" size="9" color="3" face="0">+</s><s font="3" size="9" color="3" face="2">b</s><s font="3" size="9" color="3" face="0">+</s><s font="3" size="9" color="3" face="2">c</s><s font="3" size="9" color="3" face="0">+</s><s font="3" size="9" color="3" face="2">d</s><s font="3" size="9" color="3" face="0"> ~ 15; GE-EO </s><s font="3" size="9" color="3" face="2">n</s><s font="3" size="9" color="3" face="0"> = 6-7.</s></t>
<t id="601" p="0.00 661.00" BoundingBox="0.00 654.56 452.29 663.00" Justification="Left" InterpretChemically="no"><s font="3" size="9" color="3" face="0">100 equiv. HDI per polyol molecule. </s><s font="3" size="9" color="4" face="1">Blue</s><s font="3" size="9" color="3" face="0"> = HDI-derived end group -C(=O)NH-(CH</s><s font="3" size="9" color="3" face="32">2</s><s font="3" size="9" color="3" face="0">)</s><s font="3" size="9" color="3" face="32">6</s><s font="3" size="9" color="3" face="0">-N=C=O;</s></t>
<t id="602" p="0.00 672.00" BoundingBox="0.00 665.56 418.32 674.00" Justification="Left" InterpretChemically="no"><s font="3" size="9" color="3" face="0">the new urethane bond links the terminal EO oxygen of every arm to an HDI carbonyl.</s></t>
<t id="603" p="0.00 683.00" BoundingBox="0.00 676.56 490.86 685.00" Justification="Left" InterpretChemically="no"><s font="3" size="9" color="3" face="0">The large HDI excess strongly suppresses chain extension (one HDI bridging two polyol OH groups);</s></t>
<t id="604" p="0.00 694.00" BoundingBox="0.00 687.56 460.85 696.00" Justification="Left" InterpretChemically="no"><s font="3" size="9" color="3" face="0">unreacted HDI must be removed (e.g. hexane extraction or thin-film distillation) before use.</s></t>
